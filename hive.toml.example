# Copy to ~/.config/hive/hive.toml (or run `hive init`).
# Hosts are opt-in. Hive never scrapes every Host in ~/.ssh/config.

prefix = "ctrl-space"

# The machine you are sitting on. Use local = true — do not SSH to yourself.
[[hosts]]
id = "local"
label = "local"
local = true
tmux = "tmux"

# [[hosts]]
# id = "devbox"
# ssh = "devbox"
# label = "devbox"
# tmux = "tmux"
# # socket = ""
# # control_path = "~/.ssh/hive-devbox.sock"

# tmux = "tmux" is enough. Hive finds Homebrew / MacPorts / Nix / conda
# binaries and GUI sockets. Pin a path only if you have two installs:
# tmux = "/opt/homebrew/bin/tmux"
